<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="10dp">
     
    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/userpic"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:src="@drawable/baseline_person_24"
        app:civ_border_color="@color/babypink"
        app:civ_border_width="2dp"></de.hdodenhof.circleimageview.CircleImageView>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Techpile Technology"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_toRightOf="@+id/userpic"
        android:layout_marginLeft="10sp"
        android:id="@+id/username">
    </TextView>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hello, how are you doing this time"
        android:layout_below="@+id/username"
        android:layout_toRightOf="@+id/userpic"
        android:layout_marginLeft="15sp"
        android:textColor="@color/black"
        android:id="@+id/lastmsg">
    </TextView>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="14/09"
        android:textColor="@color/purple"
        android:layout_alignParentEnd="true"
        android:id="@+id/lastmsgtime">
    </TextView>

</RelativeLayout>