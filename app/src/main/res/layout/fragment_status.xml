<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:context=".StatusFragment"
    android:orientation="vertical">

    <!-- TODO: Update blank fragment layout -->
   <RelativeLayout
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:padding="15dp">

       <de.hdodenhof.circleimageview.CircleImageView
           xmlns:app="http://schemas.android.com/apk/res-auto"
           android:layout_width="60dp"
           android:id="@+id/img_statuscamera"
           android:layout_height="60dp"
           android:src="@drawable/baseline_person_24"
           app:civ_border_color="@color/dark_blue"
           app:civ_border_width="3dp"/>
       <ImageView
           android:layout_width="wrap_content"
           android:layout_height="wrap_content"
           android:src="@drawable/baseline_add_circle_outline_24"
           android:layout_below="@+id/img_statuscamera"
           android:layout_toRightOf="@+id/img_statuscamera"
           android:layout_marginTop="-25dp"
           android:layout_marginLeft="-25dp"
           android:background="@drawable/name"></ImageView>

       <TextView
           android:layout_width="wrap_content"
           android:layout_height="wrap_content"
           android:layout_marginLeft="15dp"
           android:layout_toRightOf="@+id/img_statuscamera"
           android:text="Tap to add status update"
           android:id="@+id/tap"
           android:textStyle="bold"
           android:textSize="20dp"
           android:layout_marginTop="15dp"
           android:textColor="@color/dark_blue"></TextView>
       <TextView
           android:layout_width="wrap_content"
           android:layout_height="wrap_content"
           android:text="Viewed updates"
           android:layout_below="@+id/tap"
           android:layout_marginTop="35dp"
           android:textSize="20sp">
       </TextView>

   </RelativeLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/recycler_status"></androidx.recyclerview.widget.RecyclerView>
</LinearLayout>